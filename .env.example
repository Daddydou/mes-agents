# Copie ce fichier en .env.local et remplis les valeurs.
# Ne mets JAMAIS de vraie valeur dans ce fichier : il est versionné dans git.

# --- Commun ---
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
# Mot de passe de l'app (page /login) ; protège aussi /colis.
APP_PASSWORD=
# Facultatif : clé de signature du cookie de session.
AUTH_SECRET=

# --- Agent tennis ---
TENNIS_APP_URL=
AGENT_API_TOKEN=

# --- Agent colis ---
# Clé service role Supabase (Project Settings > API). Serveur uniquement :
# ne JAMAIS la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Google Cloud Console > Identifiants > ID client OAuth « Application de bureau ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtenu avec : node --env-file=.env.local scripts/google-auth.mjs
GOOGLE_REFRESH_TOKEN=
# Jeton exigé par /api/colis/sync (même valeur dans les secrets GitHub).
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
